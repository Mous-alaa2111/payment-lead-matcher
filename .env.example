DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app; OAuth redirect URIs are built from it.
BETTER_AUTH_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts stored Square tokens. Never rotate without re-encrypting.
TOKEN_ENCRYPTION_KEY=

# Stripe Connect (platform account): Dashboard > Settings > Connect > Onboarding options > OAuth
# Redirect URI to register: <BETTER_AUTH_URL>/api/connect/stripe/callback
STRIPE_CONNECT_CLIENT_ID=ca_...
STRIPE_SECRET_KEY=sk_test_...

# Square Developer Console > your app > OAuth
# Redirect URL to register: <BETTER_AUTH_URL>/api/connect/square/callback
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENVIRONMENT=sandbox
